# Directus static access token used by the Directus MCP server.
# Generate in Directus: open a dedicated (least-privilege) user > Token field >
# generate token > copy > save user. Then copy this file to .env and fill it in,
# OR export DIRECTUS_TOKEN in your shell before launching Claude Code.
#
# The Directus base URL is not secret and is hardcoded in .mcp.json
# (https://directus.rxedev.online/mcp).
DIRECTUS_TOKEN=your-directus-static-token-here

# --- Nuxt app (runtime) ---
# Public Directus base URL the frontend reads from (non-secret).
NUXT_PUBLIC_DIRECTUS_URL=https://directus.rxedev.online

# Server-only Directus URL for the BFF auth proxy (defaults to the public one).
NUXT_DIRECTUS_URL=https://directus.rxedev.online

# Secrets for sealing httpOnly cookies. Generate strong random values for any real
# deployment (e.g. `openssl rand -base64 48`). Never commit real values.
NUXT_SESSION_SECRET=change-me-to-a-long-random-string
NUXT_PIN_SECRET=change-me-to-a-different-long-random-string
