# Base URL of the running OpenBMS Nuxt server (npm run dev / npm run preview).
# This MCP server is an HTTP client of that server, not a standalone service —
# it will fail to do anything useful if OpenBMS isn't already running here.
OBMS_BASE_URL=http://localhost:3000

# Credentials for a dedicated, least-privilege OpenBMS user created for this MCP
# server. Do not reuse a personal login. Follow the same "create a dedicated
# service user" pattern used for the Directus MCP token (see root README.md).
OBMS_MCP_EMAIL=your-mcp-service-user@example.com
OBMS_MCP_PASSWORD=your-mcp-service-user-password
